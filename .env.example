# ================================================================
# Ryo Yamada MD - Environment Variables Template
# ================================================================
# Copy file ini ke .env dan isi nilai-nilainya.
# Di Deepnote: set variabel-variabel ini di
# Project Settings > Environment > Environment Variables
# ================================================================

# ── SESSION PERSISTENCE (WAJIB untuk Deepnote) ──────────────────
# String Base64 dari folder session/ WhatsApp Bot.
# Kosongkan jika pertama kali (nanti diisi setelah pairing).
# Cara dapat: Jalankan bot → setelah connected, copy Base64 dari log.
ANITA_SESSION_B64=

# ── BOT CONFIGURATION ────────────────────────────────────────────
# Nomor WA bot yang akan di-pair (format: 628xxx, tanpa + atau 0)
ANITA_PAIRING_NUMBER=628xxxxxxxxxx

# Nomor WA owner bot (format: 628xxx)
ANITA_OWNER_NUMBER=628xxxxxxxxxx

# ── KEEP-ALIVE SERVER ─────────────────────────────────────────────
# Port untuk HTTP keep-alive server (default: 8080)
KEEPALIVE_PORT=8080

# Set ke 'true' untuk paksa aktif keep-alive server di luar Deepnote
# (berguna untuk testing di local)
KEEPALIVE_FORCE=false

# ── VPS DEPLOYMENT (OPSIONAL) ─────────────────────────────────────
# Hanya diperlukan jika menggunakan upload_and_setup.js atau remote_setup.js
VPS_HOST=your-vps-ip
VPS_PORT=22
VPS_USER=ubuntu
VPS_PASSWORD=

# ── SESSION PERSISTENCE DEBUG ─────────────────────────────────────
# Set ke 'true' untuk paksa print Base64 session ke console
# (berguna saat testing di luar Deepnote)
SESSION_PERSISTENCE_FORCE_PRINT=false
